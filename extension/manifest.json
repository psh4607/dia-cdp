{
  "manifest_version": 3,
  "name": "Dia Codex Bridge",
  "version": "0.8.0",
  "description": "Inspect and interact with Dia pages through a local Codex CLI without recurring remote-debugging prompts.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dia Codex Bridge settings",
    "default_popup": "popup.html"
  }
}
